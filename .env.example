# Backend mode: "supabase" (default, full) or "postgres" (DB + S3-compatible storage)
BACKEND_MODE=supabase

# PostgreSQL direct connection
POSTGRES_URL=postgresql://postgres:PASSWORD@host:5432/database

# Supabase REST API (required in supabase mode — storage + rpc + rls)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# S3-compatible storage (required in postgres mode — RustFS, MinIO, SeaweedFS, AWS)
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1

# Iceberg / Data Lake (optional)
CATALOG_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
ICEBERG_WAREHOUSE=nla-audit-lake
ICEBERG_NAMESPACE=audit
CATALOG_TOKEN=
